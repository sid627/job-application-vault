{
  "manifest_version": 3,
  "name": "Job Application Vault",
  "version": "0.1.0",
  "description": "Capture the current job posting and save it to Job Application Vault.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://job-application-vault-production.up.railway.app/*"
  ],
  "action": {
    "default_title": "Save Job",
    "default_popup": "popup.html"
  }
}
